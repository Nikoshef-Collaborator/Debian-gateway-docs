#!/usr/sbin/nft -f
# gwroute: инверсная схема. По умолчанию (без метки) - VPN (таблица 100).
# 0x100 = напрямую (main -> wan), 0x200 = полоса VPS (таблица 200).
# Порядок правил в gwmark = приоритет: последнее совпадение побеждает.
table ip gwroute {
    set ru_direct     { type ipv4_addr; flags interval; auto-merge; }
    set ru_cidr       { type ipv4_addr; flags interval; auto-merge; }
    set endpoints     { type ipv4_addr; flags interval; auto-merge; }
    set cf_warp       { type ipv4_addr; flags interval; auto-merge; }
    set warp_force    { type ipv4_addr; flags interval; auto-merge; }
    set zapret_direct { type ipv4_addr; flags interval; auto-merge; }
    set ai_direct     { type ipv4_addr; flags interval; auto-merge; }
    set voice_direct  { type ipv4_addr; flags interval; auto-merge; }
    chain gwmark     { type filter hook prerouting priority mangle; policy accept; }
    chain gwmark_out { type route hook output priority mangle; policy accept; }
    chain nat        { type nat hook postrouting priority srcnat; policy accept; }
}
flush chain ip gwroute gwmark
flush chain ip gwroute gwmark_out
flush chain ip gwroute nat
flush set ip gwroute ru_cidr
flush set ip gwroute voice_direct
flush set ip gwroute endpoints
flush set ip gwroute cf_warp
# Диапазоны Cloudflare (https://www.cloudflare.com/ips-v4). Сайты за Cloudflare
# напрямую режутся ТСПУ; без этого набора .ru-сайт за Cloudflare утаскивает
# общий IP в ru_direct, и соседние сайты на том же IP ломаются.
add element ip gwroute cf_warp { 173.245.48.0/20, 103.21.244.0/22, 103.22.200.0/22, 103.31.4.0/22, 141.101.64.0/18, 108.162.192.0/18, 190.93.240.0/20, 188.114.96.0/20, 197.234.240.0/22, 198.41.128.0/17, 162.158.0.0/15, 104.16.0.0/13, 104.24.0.0/14, 172.64.0.0/13, 131.0.72.0/22 }
table ip gwroute {
    chain gwmark {
        # 1-3: endpoints и Россия -> напрямую
        ip daddr @endpoints meta mark set 0x00000100
        ip daddr @ru_cidr   meta mark set 0x00000100
        ip daddr @ru_direct meta mark set 0x00000100
        # 4-5: Cloudflare и ручной список -> обратно в WARP (кроме endpoints:
        # сам WARP-сервер лежит в диапазонах Cloudflare и обязан идти напрямую)
        ip daddr @cf_warp    ip daddr != @endpoints meta mark 0x00000100 meta mark set 0x00000000
        ip daddr @warp_force ip daddr != @endpoints meta mark 0x00000100 meta mark set 0x00000000
        # 6: Twitch и ручной "напрямую"
        ip daddr @zapret_direct meta mark set 0x00000100
        # 7-8: ИИ, голос, ручной "через VPS" -> полоса VPS
        ip daddr @ai_direct    meta mark set 0x00000200
        ip daddr @voice_direct meta mark set 0x00000200
        # всё остальное без метки -> правило "from LAN lookup 100" -> VPN
    }
    chain gwmark_out {
        # трафик самого шлюза к серверам туннелей - тоже напрямую (разрыв петли)
        ip daddr @endpoints meta mark set 0x00000100
    }
    chain nat {
        oifname "vpn-main" masquerade
        oifname "vpn-backup" masquerade
        oifname "vpn-amz" masquerade
        oifname "wan" ip saddr 192.168.50.0/24 masquerade
        # клиенты своего VPS, выходящие через домашний IP (Часть 6)
        oifname "wan" ip saddr 10.78.0.0/24 masquerade
    }
}
